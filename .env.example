# ═════════════════════════════════════════════════════════════════════
#  Gold Nightmare PERSONAL — Configuration
# ═════════════════════════════════════════════════════════════════════

# ─── App ───
APP_NAME="Gold Nightmare Personal"
APP_VERSION="3.0.0"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
BASE_URL=https://your-app.example.com

# ─── REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))" ───
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ─── REQUIRED — your personal access passcode ───
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(16))"
PERSONAL_PASSCODE=CHANGE_ME_TO_YOUR_PASSCODE

# ─── Optional — your Telegram user ID ───
# Bot will only respond to this user. Get yours via @userinfobot.
OWNER_TELEGRAM_ID=
OWNER_DISPLAY_NAME=Odai

# ─── Server ───
HOST=0.0.0.0
PORT=8000

# ─── REQUIRED — Anthropic API key ───
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7
CLAUDE_MODEL_FAST=claude-sonnet-4-6
MAX_OUTPUT_TOKENS=4096

# ─── Database ───
# For local SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./gn_personal.db
# For Render Postgres (prod):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ─── Cache (optional) ───
# REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# ─── Telegram bot (optional) ───
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=

# ─── Real-time gold price ───
GOLDAPI_KEY=
TWELVEDATA_KEY=

# ─── Upload limits ───
MAX_UPLOAD_MB=10
MAX_IMAGES_PER_ANALYSIS=4

# ─── JWT ───
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=43200

# ─── CORS ───
CORS_ORIGINS=*

# ─── Sentry (optional) ───
SENTRY_DSN=

# ─── Feature flags ───
ENABLE_PDF_EXPORT=true
ENABLE_SHARE_LINKS=true
ENABLE_BACKGROUND_SCHEDULER=true
ENABLE_FEW_SHOT_LEARNING=true
ENABLE_ML_CLASSIFIER=true
